{
  "name": "fire-marshal-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "WA DNR fire marshal dashboard plus an analytics/behavior API (descriptive analytics over historical fire records and fire-behavior models: Rothermel, Byram, Van Wagner, NFDRS).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "node --no-warnings server/sync.js",
    "server": "node --no-warnings server/index.js",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"npm:server\" \"npm:dev\"",
    "api": "node src/server.js",
    "api:dev": "node --watch src/server.js",
    "export:static": "node --no-warnings server/export-static.js",
    "build:static": "VITE_DATA_MODE=static vite build",
    "preview:static": "vite preview",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-map-gl": "^7.1.7",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "vite": "^5.4.2"
  }
}
